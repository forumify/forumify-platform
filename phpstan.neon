includes:
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-symfony/rules.neon
parameters:
    level: 8
    paths:
        - src
    ignoreErrors:
        -
            messages:
                - '#Property .+ is never written, only read.#'
                - '#Property .+ is never assigned .+ so it can be removed from the property type.#'
            path: src/**/Entity/*
        # The test kit exists for plugins to consume, so nothing in this repository has
        # to use it. The kernel configuration hooks are called by symfony via reflection.
        -
            identifier: trait.unused
            path: src/Testing/*
        -
            identifier: method.unused
            path: src/Testing/*
