{% extends '@Forumify/frontend/base.html.twig' %}
{% block title_page %}{{ user.displayName }}{% endblock %}
{% block body %}
    <div class="mb-8">
        {{ component('Forumify\\ProfileHeader', { user: user }) }}
    </div>
    <div class="grid gap-4">
        {% block profile %}
            <div class="col-xs-12 col-md-4 flex flex-col gap-4">
                {% block profile_badges %}
                    <div class="card">
                        <div class="card-title">
                            {{ 'profile.badges'|trans }}
                        </div>
                        {% if user.badges is empty %}
                            <div class="card-body">
                                <p class="text-small">{{ 'profile.no_badges'|trans }}</p>
                            </div>
                        {% else %}
                            <div class="card-body grid-xs-6 grid-md-4 gap-4 items-center">
                                {% for badge in user.badges %}
                                    <img width="100%" height="auto" src="{{ asset(badge.image, 'forumify.asset')|imagine_filter('avatar_lg') }}" title="{{ badge.name }}">
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                {% endblock %}
            </div>
            <div class="col-xs-12 col-md-8">
                {% block profile_activity %}
                    <div class="card">
                        <div class="card-title">
                            {{ 'profile.activity.activity'|trans }}
                        </div>
                        {% if comments is empty %}
                            <div class="card-body">
                                <p class="text-small">{{ 'profile.no_activity'|trans }}</p>
                            </div>
                        {% else %}
                            <ul class="card-body p-0">
                                {% for comment in comments %}
                                    {% set firstComment = comment.topic.firstComment is not null and comment.id == comment.topic.firstComment.id %}
                                    <li class="p-2 pr-4 pl-4 flex flex-col gap-2{% if not loop.last %} border-b{% endif %}">
                                        {% block activity_row %}
                                            <div class="flex items-center gap-1">
                                                {% set icon = firstComment ? 'ph-chat' : 'ph-arrow-bend-up-left' %}
                                                <i class="ph {{ icon }} text-large"></i>
                                                {% if firstComment %}
                                                    {{ 'profile.activity.created'|trans }}
                                                    <a href="{{ path('forumify_forum_topic', {
                                                        slug: comment.topic.slug
                                                    }) }}">
                                                        {{ comment.topic }}
                                                    </a>
                                                    {{ 'profile.activity.in'|trans }}
                                                    <a href="{{ path('forumify_forum_forum', {
                                                        slug: comment.topic.forum.slug
                                                    }) }}">
                                                        {{ comment.topic.forum }}
                                                    </a>
                                                {% else %}
                                                    {{ 'profile.activity.commented'|trans }}
                                                    <a href="{{ path('forumify_forum_topic', {
                                                        slug: comment.topic.slug
                                                    }) }}">
                                                        {{ comment.topic }}
                                                    </a>
                                                {% endif %}
                                            </div>
                                            <p>
                                                {{ comment.content|striptags|u.truncate(500, '...', false) }}
                                            </p>
                                            <div class="text-small">
                                                {{ comment.createdAt|format_date }}
                                            </div>
                                        {% endblock %}
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>
                {% endblock %}
            </div>
        {% endblock %}
    </div>
{% endblock %}
