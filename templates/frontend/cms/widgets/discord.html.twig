{% if widget.settings.serverId %}
    <div {{ stimulus_controller('forumify/discord-widget', {
        serverId: widget.settings.serverId,
    }) }}>
        {% embed '@Forumify/components/modal.html.twig' %}
            {% block modalOpenButton %}
                <button
                    class="btn-idp-discord{% if not widget.settings.serverName %} btn-icon{% endif %}"
                    {{ stimulus_action('forumify/discord-widget', 'openModal') }}
                >
                    <i class="ph-fill ph-discord-logo"></i>
                    {{ widget.settings.serverName }}
                </button>
            {% endblock %}
            {% block modalContent %}
                <div class="box">
                    <iframe
                        {{ stimulus_target('forumify/discord-widget', 'iframe') }}
                        width="100%"
                        height="600"
                        allowtransparency="true"
                        frameborder="0"
                        sandbox="allow-popups allow-popups-to-escape-sandbox allow-same-origin allow-scripts"
                    ></iframe>
                </div>
            {% endblock %}
        {% endembed %}
    </div>
{% endif %}
