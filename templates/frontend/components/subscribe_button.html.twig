<div {{ attributes }}>
    {% if app.user is null %}
        <a class="{{ this.buttonClass }}" href="{{ path('forumify_core_login', { '_target_path': app.request.requestUri }) }}">
            {% if this.subscribeIcon is not empty %}
                <i class="{{ this.subscribeIcon }}"></i>
                <span class="hide-phone ml-2">{{ this.subscribeLabel|trans }}</span>
            {% else %}
                <span>{{ this.subscribeLabel|trans }}</span>
            {% endif %}
        </a>
    {% else %}
        {% set subscription = this.subscription %}
        {% set icon = subscription is null ? this.subscribeIcon : this.unsubscribeIcon %}
        {% set label = subscription is null ? this.subscribeLabel : this.unsubscribeLabel %}
        <button class="{{ this.buttonClass }}" data-action="live#action" data-live-action-param="toggleSubscription">
            {% if icon is not empty %}
                <i class="{{ icon }}"></i>
                <span class="hide-phone ml-2">{{ label|trans }}</span>
            {% else %}
                <span>{{ label|trans }}</span>
            {% endif %}
        </button>
    {% endif %}
</div>
